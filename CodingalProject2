<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Susan's Restaurant - Menu & Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <section id="menu-section">
        <div class="container">
            <h2 class="section-title">Our Special Menu</h2>
            <p class="section-subtitle">Freshly prepared daily with local, organic ingredients</p>
            
            <div class="menu-container">
                <div class="menu-item">
                    <span class="item-name">Classic Margherita Pizza</span>
                    <span class="item-price">£12.50</span>
                    <p class="item-description">Fresh mozzarella, organic tomatoes, and garden-fresh basil leaves.</p>
                </div>

                <div class="menu-item">
                    <span class="item-name">Gourmet Beef Burger</span>
                    <span class="item-price">£14.95</span>
                    <p class="item-description">Angus beef patty, cheddar cheese, crisp lettuce, and signature house sauce.</p>
                </div>

                <div class="menu-item">
                    <span class="item-name">Caesar Salad</span>
                    <span class="item-price">£9.50</span>
                    <p class="item-description">Crispy romaine lettuce, garlic croutons, Parmesan, and creamy Caesar dressing.</p>
                </div>

                <div class="menu-item">
                    <span class="item-name">Creamy Truffle Pasta</span>
                    <span class="item-price">£16.00</span>
                    <p class="item-description">Wild mushrooms, parmesan cheese, and a rich, velvety black truffle sauce.</p>
                </div>
            </div>
        </div>
    </section>

    <hr class="section-divider">

    <section id="portfolio-section">
        <div class="container">
            <h2 class="section-title">Our Food Portfolio</h2>
            <p class="section-subtitle">A visual glimpse into our culinary creations</p>

            <div class="portfolio-grid">
                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?q=80&w=500" alt="Fresh Pizza">
                    <div class="portfolio-overlay">
                        <h3>Stone Baked Pizza</h3>
                    </div>
                </div>

                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=500" alt="Juicy Burger">
                    <div class="portfolio-overlay">
                        <h3>Signature Burgers</h3>
                    </div>
                </div>

                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=500" alt="Healthy Salad Bowl">
                    <div class="portfolio-overlay">
                        <h3>Fresh Salads</h3>
                    </div>
                </div>

                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1551183053-bf91a1d81141?q=80&w=500" alt="Delicious Dessert">
                    <div class="portfolio-overlay">
                        <h3>Decadent Desserts</h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

</body>
</html>
